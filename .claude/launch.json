{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Frontend (React + Craco)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start"],
      "port": 3001
    },
    {
      "name": "Convex Backend",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["convex", "dev"],
      "port": 3210
    },
    {
      "name": "FastAPI Backend",
      "runtimeExecutable": "uvicorn",
      "runtimeArgs": ["backend.server:app", "--reload"],
      "port": 8000
    }
  ]
}
